@{
}

<div>
    <h3>Deleting Student</h3>
    <p>Student Name: @Model.name</p>
    <p>Department: @Model.department</p>
    <p>Cgpa: @Model.cgpa</p>

    <p>Are you sure you want to delete this student? </p>
    <form method="post" action="/student/remove/@Model.id">
        <button type="submit" class="btn btn-danger">Yes</button>
        <a href="/student" class="btn btn-primary">No</a>
    </form>
    
</div>