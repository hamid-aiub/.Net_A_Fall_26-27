@{
}

<div>
    <h4>Update a new student</h4>
    <form method="post" action="/student/update/@Model.id">
        <table>
            <tr>
                <td>Name</td>
                <td><input type="text" name="name" placeholder="Enter Name" value="@Model.name"/> </td>
            </tr>
            <tr>
                <td>Department</td>
                <td><input type="text" name="department" placeholder="Enter Department" value="@Model.department" /> </td>
            </tr>
            <tr>
                <td>Cgpa</td>
                <td><input type="text" name="cgpa" placeholder="Enter Cgpa" value="@Model.cgpa"/> </td>
            </tr>
            <tr>
                <td></td>
                <td><button type="submit">Update</button></td>
            </tr>
        </table>
    </form>
</div>