@model Intro_EF_A.Models.Student;

<div>
    <h4>Create a new student</h4>
    <form method="post" action="/student/create">
        <table>
            <tr>
                <td>Name</td>
                <td><input type="text" name="name" placeholder="Enter Name" value="@Model?.name" class="form-control"/> </td>
                <td><span class="text-danger">@Html.ValidationMessage("name")</span></td>
            </tr>
            <tr>
                <td>Department</td>
                <td><input type="text" name="department" placeholder="Enter Department" value="@Model?.department" class="form-control" /> </td>
                <td><span class="text-danger">@Html.ValidationMessage("department")</span></td>
            </tr>
            <tr>
                <td>Cgpa</td>
                <td><input type="text" name="cgpa" placeholder="Enter Cgpa" value="@Model?.cgpa" class="form-control" /> </td>
                <td><span class="text-danger">@Html.ValidationMessage("cgpa")</span></td>
            </tr>
            <tr>
                <td></td>
                <td><button type="submit" >Create</button></td>
            </tr>
        </table>    
    </form>
</div>